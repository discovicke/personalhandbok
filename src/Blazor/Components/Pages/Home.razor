@page "/"
@rendermode InteractiveServer
@using Blazor.Services
@using Shared.Models
@inject IChatService ChatService

<PageTitle>Personalhandboksassistent</PageTitle>

<h1>Kalle Anka AB - Personalhandboksassistent</h1>
<p class="text-muted">Testa att ställa en fråga till assistenten baserat på handboken.</p>

<div class="card p-3 my-3">
    <div class="mb-3">
        <label for="questionInput" class="form-label font-weight-bold">Din fråga:</label>
        <div class="input-group">
            <input id="questionInput" 
                   class="form-control" 
                   @bind="userQuestion" 
                   @bind:event="oninput" 
                   placeholder="T.ex. Vad gäller för semester? eller Hur fungerar friskvårdsbidraget?" />
            <button class="btn btn-primary" @onclick="AskAssistant" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Söker och tänker...</span>
                }
                else
                {
                    <span>Fråga assistenten</span>
                }
            </button>
        </div>
    </div>
</div>

@if (chatResponse is not null)
{
    <div class="card border-success my-3">
        <div class="card-header bg-success text-white">
            <strong>Assistentens svar</strong>
        </div>
        <div class="card-body">
            <p class="card-text" style="white-space: pre-wrap;">@chatResponse.Answer</p>

            @if (chatResponse.Citations.Count > 0)
            {
                <hr />
                <h6>Källor och referenser (@chatResponse.Citations.Count st):</h6>
                <ul class="list-group list-group-flush">
                    @foreach (var citation in chatResponse.Citations)
                    {
                        <li class="list-group-item bg-light mb-1 border rounded">
                            <div><strong>Dokument:</strong> @citation.FileName (@citation.ChunkId)</div>
                            <div class="text-muted small mt-1"><em>"@citation.Quote"</em></div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        <strong>Ett fel inträffade:</strong>
        <p class="mb-0">@errorMessage</p>
    </div>
}

@code {
    private string userQuestion = "Vad gäller för semester?";
    private ChatResponse? chatResponse;
    private string? errorMessage;
    private bool isLoading;

    private async Task AskAssistant()
    {
        if (string.IsNullOrWhiteSpace(userQuestion))
            return;

        isLoading = true;
        errorMessage = null;
        chatResponse = null;

        try
        {
            chatResponse = await ChatService.AskAsync(userQuestion);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}