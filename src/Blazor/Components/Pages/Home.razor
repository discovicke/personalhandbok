@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@using Blazor.Models
@using Blazor.Services
@using Blazor.Services.Interfaces
@inject IChatService ChatService
@inject IJSRuntime JSRuntime

<PageTitle>Personalhandboksassistent</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Kalle Anka AB - Personalhandboksassistent</h1>
        <p class="text-muted small mb-0">Ställ frågor och följdfrågor baserat på handboken. Samtalet sparas lokalt i webbläsaren.</p>
    </div>
    @if (conversation.Count > 0)
    {
        <button class="btn btn-outline-danger btn-sm" @onclick="ClearConversation" disabled="@isLoading" title="Rensa sparad historik">
            Rensa samtal
        </button>
    }
</div>

<!-- Meddelandetråd / Chattflöde -->
<div class="chat-container my-3">
    @if (conversation.Count == 0 && !isLoading)
    {
        <div class="card p-4 text-center text-muted bg-light border-0 my-4">
            <h5>Välkommen till personalassistenten!</h5>
            <p class="mb-0">
                Ställ en fråga om anställningsvillkor, förmåner, semester eller säkerhet.<br />
                <em>Exempel: "Vad gäller för semester?" eller "Vad ingår i friskvårdsbidraget?"</em>
            </p>
        </div>
    }

    @foreach (var msg in conversation)
    {
        @if (msg.Role == ConversationMessage.UserRole)
        {
            <!-- Användarmeddelande (högerställt) -->
            <div class="d-flex justify-content-end mb-3">
                <div class="card bg-primary text-white shadow-sm" style="max-width: 80%;">
                    <div class="card-body py-2 px-3">
                        <div class="small text-white-50 mb-1 d-flex justify-content-between">
                            <strong>Du</strong>
                            @if (msg.Timestamp.HasValue)
                            {
                                <span class="ms-2">@msg.Timestamp.Value.ToString("HH:mm")</span>
                            }
                        </div>
                        <p class="card-text mb-0" style="white-space: pre-wrap;">@msg.Content</p>
                    </div>
                </div>
            </div>
        }
        else if (msg.Role == ConversationMessage.AssistantRole)
        {
            <!-- Assistentmeddelande (vänsterställt) -->
            @if (msg.IsRefused)
            {
                <!-- Avböjt svar (rött kort) -->
                <div class="d-flex justify-content-start mb-3">
                    <div class="card border-danger shadow-sm" style="max-width: 85%;">
                        <div class="card-header bg-danger text-white py-1 px-3 d-flex justify-content-between align-items-center">
                            <strong>Assistenten kan inte svara</strong>
                            @if (msg.Timestamp.HasValue)
                            {
                                <span class="small text-white-50">@msg.Timestamp.Value.ToString("HH:mm")</span>
                            }
                        </div>
                        <div class="card-body py-2 px-3">
                            <p class="card-text mb-0" style="white-space: pre-wrap;">@ChatStreamHelper.TrimRefusalPrefix(msg.RefusalReason ?? string.Empty)</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Godkänt svar (grönt kort med källor) -->
                <div class="d-flex justify-content-start mb-3">
                    <div class="card border-success shadow-sm" style="max-width: 85%;">
                        <div class="card-header bg-success text-white py-1 px-3 d-flex justify-content-between align-items-center">
                            <strong>Assistentens svar</strong>
                            @if (msg.Timestamp.HasValue)
                            {
                                <span class="small text-white-50">@msg.Timestamp.Value.ToString("HH:mm")</span>
                            }
                        </div>
                        <div class="card-body py-2 px-3">
                            <p class="card-text mb-0" style="white-space: pre-wrap;">@msg.Content</p>

                            @if (msg.Citations is not null && msg.Citations.Count > 0)
                            {
                                <hr class="my-2" />
                                <h6 class="small text-muted mb-2">Källor och referenser (@msg.Citations.Count st):</h6>
                                <ul class="list-group list-group-flush small">
                                    @foreach (var citation in msg.Citations)
                                    {
                                        <li class="list-group-item bg-light mb-1 border rounded py-1 px-2">
                                            <div><strong>Dokument:</strong> @citation.FileName @(string.IsNullOrWhiteSpace(citation.ChunkId) ? "" : $"({citation.ChunkId})")</div>
                                            <div class="text-muted small mt-1"><em>"@citation.Quote"</em></div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }

    <!-- Laddningsindikator -->
    @if (isLoading)
    {
        <div class="d-flex justify-content-start mb-3">
            <div class="card border-secondary bg-light shadow-sm" style="max-width: 85%;">
                <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="text-muted small">Assistenten söker i handboken och tänker...</span>
                </div>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        <strong>Ett fel inträffade:</strong>
        <p class="mb-0">@errorMessage</p>
    </div>
}

<!-- Inmatningsfält -->
<div class="card p-3 my-3 shadow-sm bg-white">
    <div class="input-group">
        <input id="questionInput" 
               class="form-control" 
               @bind="userQuestion" 
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               placeholder="Ställ en fråga eller följdfråga... (tryck Enter för att skicka)" 
               disabled="@isLoading" />
        <button class="btn btn-primary px-4" @onclick="AskAssistant" disabled="@(isLoading || string.IsNullOrWhiteSpace(userQuestion))">
            @if (isLoading)
            {
                <span>Tänker...</span>
            }
            else
            {
                <span>Skicka</span>
            }
        </button>
    </div>
</div>

@code {
    private const string StorageKey = "kalle_anka_chat_history";
    private List<ConversationMessage> conversation = [];
    private string userQuestion = "";
    private string? errorMessage;
    private bool isLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", StorageKey);
                if (!string.IsNullOrWhiteSpace(json))
                {
                    var loaded = JsonSerializer.Deserialize<List<ConversationMessage>>(json);
                    if (loaded is not null)
                    {
                        conversation = loaded;
                        StateHasChanged();
                    }
                }
            }
            catch
            {
                // Ignorera fel om localStorage t.ex. är blockerat i webbläsaren
            }
        }
    }

    private async Task AskAssistant()
    {
        if (string.IsNullOrWhiteSpace(userQuestion) || isLoading)
            return;

        var question = userQuestion.Trim();
        userQuestion = string.Empty;
        errorMessage = null;

        // 1. Skapa användarmeddelande och lägg till i listan
        var userMsg = ConversationMessage.CreateUser(question);
        conversation.Add(userMsg);
        isLoading = true;

        // Spara frågan direkt i localStorage så att den syns även om användaren laddar om sidan
        await SaveToLocalStorageAsync();

        try
        {
            // 2. Extrahera alla tidigare meddelanden (före den aktuella frågan) som historik till AI:n
            var history = conversation
                .Take(conversation.Count - 1)
                .Select(m => m.ToChatMessage())
                .ToList();

            // 3. Ställ frågan till ChatService med samtalshistorik
            var response = await ChatService.AskAsync(question, history);

            // 4. Lägg till assistentens svar i samtalet
            var assistantMsg = ConversationMessage.CreateAssistant(response);
            conversation.Add(assistantMsg);

            // 5. Spara uppdaterat samtal till localStorage
            await SaveToLocalStorageAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearConversation()
    {
        conversation.Clear();
        errorMessage = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", StorageKey);
        }
        catch
        {
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await AskAssistant();
        }
    }

    private async Task SaveToLocalStorageAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(conversation);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
        }
        catch
        {
        }
    }
}