@page "/admin"
@rendermode InteractiveServer
@using Blazor.Services
@using Microsoft.JSInterop
@inject IDocumentService Documents
@inject IJSRuntime JS

<PageTitle>Admin</PageTitle>

<div class="admin-header">
    <h1>Dokument</h1>
    <p>Hantera dokument som används av personalhandboksassistenten.</p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Ladda upp dokument</h5>
        <p class="card-text text-muted">
            Välj ett dokument att lägga till i personalhandboken.
        </p>

        <div class="d-flex align-items-center gap-2">
            <InputFile OnChange="OnFileChosen" accept=".pdf,.docx,.doc,.md,.markdown,.txt" class="form-control" />

            <button class="btn btn-primary" @onclick="LaddaUpp" disabled="@(valdFil is null || laddarUpp)">
                @(laddarUpp ? "Laddar upp..." : "Ladda upp")
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(meddelande))
{
    <p>@meddelande</p>
}

@if (!string.IsNullOrEmpty(feltext))
{
    <p class="alert alert-warning">@feltext</p>
}

<h2 class="mb-3">Filer</h2>

@if (filer is null)
{
    <p class="text-muted">Laddar...</p>
}
else if (filer.Count == 0)
{
    <div class="alert alert-light border">
        Inga filer ännu.
    </div>
}
else
{
    <div class="list-group mb-4">

        @foreach (var fil in filer)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">
                        @fil.FileName
                    </div>

                    <small class="text-muted">
                        @fil.SizeBytes bytes
                        ·
                        @fil.UploadedAt.LocalDateTime.ToShortDateString()
                    </small>
                </div>

                <button class="btn btn-outline-danger btn-sm" @onclick="() => TaBort(fil.Id)">
                    Ta bort
                </button>
            </div>
        }

    </div>
}

@code {
    private IBrowserFile? valdFil;
    private IReadOnlyList<Shared.Models.DocumentMetadata>? filer;
    private string? meddelande;
    private string? feltext;
    private bool laddarUpp;

    protected override async Task OnInitializedAsync()
    {
        await LäsFiler();
    }

    private void OnFileChosen(InputFileChangeEventArgs e)
    {
        valdFil = e.File;
        meddelande = null;
        feltext = null;
    }

    private async Task LaddaUpp()
    {
        if (valdFil is null)
            return;

        laddarUpp = true;
        meddelande = null;
        feltext = null;

        try
        {
            if (filer is not null && filer.Any(f => f.Id == valdFil.Name) &&
                !await JS.InvokeAsync<bool>("confirm", $"Filen {valdFil.Name} finns redan. Ersätta den?"))
                return;

            await using var stream = valdFil.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var meta = await Documents.UploadAsync(stream, valdFil.Name, valdFil.ContentType);
            meddelande = $"{meta.FileName} laddad upp. Den går att söka på efter en stund.";
            valdFil = null;
            await LäsFiler();
        }
        catch (IndexerTriggerException)
        {
            // Filen är uppe, bara indexeringen som dröjer. Info, inte fel.
            meddelande = AzureErrorHandler.IndexerDelayed;
            valdFil = null;
            await LäsFiler();
        }
        catch (Exception ex)
        {
            feltext = AzureErrorHandler.UserFriendlyError(ex);
        }
        finally
        {
            laddarUpp = false;
        }
    }

    private async Task TaBort(string documentId)
    {
        meddelande = null;
        feltext = null;

        if (!await JS.InvokeAsync<bool>("confirm", $"Ta bort {documentId}?"))
            return;

        try
        {
            await Documents.DeleteAsync(documentId);
            meddelande = $"{documentId} borttagen. Den försvinner från sök inom kort.";
            await LäsFiler();
        }
        catch (IndexerTriggerException)
        {
            // Filen är borta, bara indexeringen som dröjer. Info, inte fel.
            meddelande = $"{documentId} borttagen. Den försvinner från sök inom kort.";
            await LäsFiler();
        }
        catch (Exception ex)
        {
            feltext = AzureErrorHandler.UserFriendlyError(ex);
        }
    }

    private async Task LäsFiler()
    {
        try
        {
            filer = await Documents.ListAsync();
        }
        catch (Exception ex)
        {
            feltext = AzureErrorHandler.UserFriendlyError(ex);
        }
    }
}